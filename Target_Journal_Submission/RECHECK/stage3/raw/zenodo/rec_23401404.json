{"created": "2026-10-15T17:24:42.900991+00:00", "modified": "2026-10-15T21:12:31.389785+00:00", "id": 23401404, "conceptrecid": "23401403", "doi": "10.5281/zenodo.23401404", "conceptdoi": "10.5281/zenodo.23401403", "doi_url": "https://doi.org/10.5281/zenodo.23401404", "metadata": {"title": "A Real-World HVAC Dataset for Time-Series Prediction, Data-Driven Modeling, and Fault Detection.", "doi": "10.5281/zenodo.23401404", "publication_date": "2025-10-15", "description": "<p>The AHU dataset is designed to support time-history prediction and fault detection in Air Handling Units (AHUs). It has been used in three published research articles, demonstrating its applicability to data-driven modeling, predictive analysis, and fault detection.&nbsp;</p>\n<p>1)&nbsp; Data-driven approach to fault detection for hospital HVAC system</p>\n<p><a href=\"https://doi.org/10.1108/SASBE-05-2024-0169\" rel=\"noopener\">https://doi.org/10.1108/SASBE-05-2024-0169</a></p>\n<p>2)&nbsp; <span class=\"title-text\">A data-driven based framework for resilience assessment of hospital HVAC systems</span></p>\n<p><span class=\"title-text\"><a class=\"anchor anchor-secondary\" href=\"https://doi.org/10.1016/j.jobe.2025.113656\" rel=\"noreferrer noopener\"><span class=\"anchor-text-container\"><span class=\"anchor-text\">10.1016/j.jobe.2025.113656</span></span></a></span></p>\n<p><span class=\"title-text\">3)&nbsp; </span><span class=\"article_title fw-bold\">Predictive Maintenance of HVAC Systems using Deep Learning for Optimized Building Energy Efficiency</span></p>\n<p><span class=\"title-text\">&nbsp;<a href=\"https://doi.org/10.61186/NMCE.2506.1092\">10.61186/NMCE.2506.1092</a></span></p>\n<p><span class=\"title-text\">The dataset is publicly available on Zenodo to facilitate reproducibility and support further research in building energy systems and HVAC operation.</span></p>", "access_right": "open", "creators": [{"name": "Seyed Abolfazl, Aghili", "affiliation": "Iran University of Science and Technology"}, {"name": "Monirvaghefi, Zeinab", "affiliation": "K.N.Toosi University of Technology", "orcid": "0000-0002-5343-5361"}], "resource_type": {"title": "Dataset", "type": "dataset"}, "license": {"id": "cc-by-4.0"}, "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "23401403"}}]}}, "title": "A Real-World HVAC Dataset for Time-Series Prediction, Data-Driven Modeling, and Fault Detection.", "links": {"self": "https://zenodo.org/api/records/23401404", "self_html": "https://zenodo.org/records/23401404", "preview_html": "https://zenodo.org/records/23401404?preview=1", "doi": "https://doi.org/10.5281/zenodo.23401404", "self_doi": "https://doi.org/10.5281/zenodo.23401404", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23401404", "reserve_doi": "https://zenodo.org/api/records/23401404/draft/pids/doi", "parent": "https://zenodo.org/api/records/23401403", "parent_html": "https://zenodo.org/records/23401403", "parent_doi": "https://doi.org/10.5281/zenodo.23401403", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23401403", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:23401404/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:23401404/sequence/default", "files": "https://zenodo.org/api/records/23401404/files", "media_files": "https://zenodo.org/api/records/23401404/media-files", "latest": "https://zenodo.org/api/records/23401404/versions/latest", "latest_html": "https://zenodo.org/records/23401404/latest", "versions": "https://zenodo.org/api/records/23401404/versions", "draft": "https://zenodo.org/api/records/23401404/draft", "access_links": "https://zenodo.org/api/records/23401404/access/links", "access_grants": "https://zenodo.org/api/records/23401404/access/grants", "access_users": "https://zenodo.org/api/records/23401404/access/users", "access_request": "https://zenodo.org/api/records/23401404/access/request", "access": "https://zenodo.org/api/records/23401404/a